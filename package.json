{
  "name": "level-up",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "android:apk": "cross-env VITE_SERVER_URL=https://game.peos.cn vite build && cap sync android && cd android && gradlew.bat assembleDebug",
    "test:redis": "REDIS_IT=1 vitest run tests/repo.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "argon2": "0.45.1",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "phaser": "^3.70.0",
    "phaser3-rex-plugins": "1.80.20"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.0.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
